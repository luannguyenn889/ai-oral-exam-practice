# Google Gemini API Key (co the khai bao nhieu key cach nhau bang dau phay o GEMINI_API_KEYS)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2,your_gemini_api_key_3

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Default AI Providers & Models
DEFAULT_STT_PROVIDER=groq
DEFAULT_LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=local
EMBEDDING_BACKEND=auto
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-2
GEMINI_EMBEDDING_BATCH_SIZE=100
GEMINI_EMBEDDING_MAX_WORKERS=3
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
OLLAMA_BASE_URL=http://localhost:11434

# Data & Vector DB Storage Paths
DATA_DIR=data
DOCUMENTS_DIR=data/documents
CHROMA_DB_DIR=data/chroma_db

